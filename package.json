{
  "name": "trip-planner",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,web -c gray,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch server/index.ts",
    "dev:web": "vite",
    "build": "vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json && tsc -p tsconfig.server.json"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.6",
    "@types/tz-lookup": "^6.1.2",
    "concurrently": "^10.0.6",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.6"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "tz-lookup": "^6.1.25"
  }
}
